# Lumé environment
# Copy this file to .env and fill in your server-side YouCam credentials.

PORT=3001

# Perfect Corp YouCam API key. Server-side only — never prefix with VITE_.
YOUCAM_API_KEY=

# Official API host
YOUCAM_API_HOST=https://yce-api-01.makeupar.com

# Show the clearly labelled sample report when the API is unavailable.
# This never enables fake live scans or fake try-on results.
DEV_FIXTURES=true

# Optional upload and job limits
MAX_UPLOAD_MB=10
SKIN_POLL_INTERVAL_MS=5000
SKIN_TASK_MAX_WAIT_MS=300000
TRYON_TASK_MAX_WAIT_MS=300000

# Allowed browser origin for direct API development (Vite uses a proxy by default).
CLIENT_ORIGIN=http://localhost:5173
